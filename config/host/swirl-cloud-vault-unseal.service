[Unit]
Description=Unseal the in-cluster Vault from root-only host material
After=k3s.service
Requires=k3s.service
ConditionPathExists=/var/lib/swirl-cloud/vault-unseal-key

[Service]
Type=oneshot
User=root
Group=root
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
RuntimeDirectory=swirl-cloud-vault-unseal
Environment=HOME=/run/swirl-cloud-vault-unseal
ExecStart=/usr/local/sbin/swirl-cloud-vault-unseal
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/rancher/k3s /var/lib/swirl-cloud
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
