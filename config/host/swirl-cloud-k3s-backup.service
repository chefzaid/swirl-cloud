[Unit]
Description=Create consistent K3s, Vault, and application recovery backups
After=k3s.service
Requires=k3s.service

[Service]
Type=oneshot
User=root
Group=root
Environment=HOME=/run/swirl-cloud-k3s-backup
RuntimeDirectory=swirl-cloud-k3s-backup
ExecStart=/usr/local/sbin/swirl-cloud-k3s-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/rancher/k3s /etc/swirl-cloud /var/lib/rancher/k3s /var/lib/swirl-cloud
ReadWritePaths=/var/backups/swirl-cloud/k3s /run/lock
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
