# Shared deployment contract.
#
# Keep values shell-safe and unquoted: this file is sourced by Bash and read as
# a Java-properties file by Ansible. Lists are comma-separated and ordered.

PLATFORM_CONTRACT_VERSION=7

DEFAULT_K3S_INSTALL_VERSION=v1.36.4+k3s1
# Helm binary installed when missing; checksums from get.helm.sh/<archive>.sha256sum.
DEFAULT_HELM_VERSION=v3.22.0
DEFAULT_HELM_LINUX_AMD64_SHA256=1e4ab49e429626cf6c6958d914248b78c9730803c2751b87627e171dc800e7bb
DEFAULT_HELM_LINUX_ARM64_SHA256=f14e804dfee240f55525b667488fe9adca349e63e00c9af634c0beb1421ac310
DEFAULT_TRAEFIK_CHART_VERSION=41.6.0
DEFAULT_LONGHORN_CHART_VERSION=1.13.0
# Percentage of node CPU each v1 instance manager reserves (Longhorn default 12;
# measured use 0.2-0.26 core on 8 cores).
DEFAULT_LONGHORN_GUARANTEED_INSTANCE_MANAGER_CPU=5
DEFAULT_VAULT_CHART_VERSION=0.34.1
DEFAULT_EXTERNAL_SECRETS_CHART_VERSION=2.11.0
DEFAULT_ARGOCD_CHART_VERSION=10.9.2
DEFAULT_ARGOCD_IMAGE_TAG=v3.5.3@sha256:dd3f47d5a5e4da563a7a398506e892481b358a7cec50abdf320c71aa55904bfa
DEFAULT_PLATFORM_DOMAIN=
DEFAULT_INTERNAL_DNS_ZONE=
DEFAULT_K3S_REGISTRY_HOST=
DEFAULT_K3S_REGISTRY_ENDPOINT=http://10.43.255.251:5050

DEFAULT_LONGHORN_HELM_TIMEOUT=1200s
DEFAULT_LONGHORN_POD_WAIT_TIMEOUT=300s
DEFAULT_INGRESS_HELM_TIMEOUT=300s
DEFAULT_VAULT_WAIT_TIMEOUT=300s
DEFAULT_EXTERNAL_SECRETS_HELM_TIMEOUT=300s
DEFAULT_EXTERNAL_SECRET_WAIT_TIMEOUT=180s
DEFAULT_ARGOCD_HELM_TIMEOUT=600s
DEFAULT_DATASTORE_WAIT_TIMEOUT=300s
DEFAULT_PLATFORM_WAIT_TIMEOUT=900s

FOUNDATION_MANIFESTS=base/platform-identity.yaml,base/coredns-custom.yaml,base/system-workload-hardening.yaml,base/application-policies.yaml
DATASTORE_MANIFESTS=datastores/postgres.yaml,datastores/kafka.yaml,datastores/redis.yaml,datastores/mongodb.yaml
PLATFORM_MANIFESTS=platform/longhorn-maintenance.yaml,platform/volume-encryption.yaml,platform/vault-ui-theme.yaml,platform/keycloak.yaml,platform/keycloak-sso.yaml,platform/monitoring.yaml,platform/trivy.yaml,platform/trivy-policy-data.yaml,platform/security-detection.yaml,platform/elk.yaml,platform/platform-reports.yaml,platform/logging-agent.yaml,platform/observability-discovery.yaml,platform/application-observability.yaml,platform/sonarqube.yaml,platform/gitlab.yaml,platform/gitlab-runner.yaml,platform/gitlab-registry-retention.yaml,platform/dbgate.yaml,platform/kafka-ui.yaml,platform/portainer.yaml,platform/portainer-bootstrap-job.yaml,platform/homepage.yaml,platform/ingress.yaml
POST_ARGOCD_MANIFESTS=addons/swirl-cloud-application.yaml
EXTERNAL_SECRET_NAMES=postgres-secret,mongodb-secret,sonarqube-db-credentials,sonarqube-sso-admin-token,grafana-admin-secret,monitoring-alert-credentials,keycloak-admin-secret,keycloak-realm-config,keycloak-sso-credentials,dbgate-auth-secret,kafka-ui-auth-secret,portainer-auth-secret,platform-ui-basic-auth,elasticsearch-security-bootstrap,kibana-system-credentials,logstash-elasticsearch-credentials,grafana-elasticsearch-credentials,kibana-bootstrap-credentials,kibana-keycloak-proxy-credentials,security-detection-credentials,longhorn-volume-encryption
DATASTORE_WAIT_APPS=postgres,redis,mongodb,kafka-controller,kafka
PLATFORM_WAIT_APPS=vault-ui-theme,keycloak,oauth2-proxy,elasticsearch,kibana,logstash,kube-state-metrics,prometheus,alertmanager,grafana,sonarqube,gitlab,dbgate,kafka-ui,portainer,homepage
# Node-level telemetry agents run in their own privileged namespace so infra
# can enforce the baseline Pod Security Standard.
HOST_AGENTS_NAMESPACE=host-agents
HOST_AGENTS_EXTERNAL_SECRET_NAMES=fluent-bit-elasticsearch-credentials
PLATFORM_WAIT_DAEMONSETS=node-exporter,fluent-bit,filebeat-lynis

DEFAULT_CLOUDFLARE_ZONE=
DEFAULT_CLOUDFLARE_NODE_DNS_LABEL=node-01
DEFAULT_CLOUDFLARE_ACCESS_TEAM_NAME=
DEFAULT_CLOUDFLARE_HOST_LABELS=argocd,cloud,dbgate,gitlab,grafana,kafka,keycloak,kibana,longhorn,odoo,portainer,registry,sonarqube,vault
DEFAULT_CLOUDFLARE_ACCESS_HOST_LABELS=argocd,cloud,dbgate,grafana,kafka,kibana,longhorn,portainer,sonarqube,vault
DEFAULT_CLOUDFLARE_RETIRED_HOST_LABELS=dashboard,intranet
DEFAULT_CLOUDFLARE_NON_BROWSER_HOST_LABELS=registry

# Private node transport. vRack is OVHcloud-only. Tailscale is the provider-neutral
# choice for hybrid clouds and providers other than OVHcloud. lan uses nodes'
# existing fixed RFC1918 addresses on one local network without either.
DEFAULT_K3S_NODE_TRANSPORT=vrack
DEFAULT_TAILSCALE_TAILNET=-
# A tailnet may carry several clusters spanning unrelated providers. Role tags
# are derived as tag:<mesh>-control-plane and tag:<mesh>-worker.
DEFAULT_TAILSCALE_MESH_NAME=swirl-cloud
DEFAULT_TAILSCALE_AUTH_KEY_EXPIRY_SECONDS=3600
