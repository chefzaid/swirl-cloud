<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- The correspondent's name, with an online status line in the website's chat frame. -->
    <t t-inherit="mail.ChatWindow.headerContent" t-inherit-mode="extension">
        <xpath expr="//div[@t-esc='props.chatWindow.displayName']" position="replace">
            <div t-if="platformStatus and !state.editingName" class="o-platform-ChatWindow-title d-flex flex-column text-truncate o-mx-0_5">
                <t>$0</t>
                <span class="o-platform-ChatWindow-status d-flex align-items-center">
                    <span class="o-platform-ChatWindow-online" aria-hidden="true"/>
                    <t t-esc="platformStatus"/>
                </span>
            </div>
            <t t-else="">$0</t>
        </xpath>
    </t>
</templates>
