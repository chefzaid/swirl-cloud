<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_website_chat_notify" model="ir.cron">
        <field name="name">Website chat: email new visitor messages to the team</field>
        <field name="model_id" ref="mail.model_discuss_channel"/>
        <field name="state">code</field>
        <field name="code">model._platform_notify_team()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
