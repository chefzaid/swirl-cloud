{
  "uid": "platform-report",
  "title": "Platform Report",
  "description": "Monthly service levels, cost and compliance from hourly snapshots kept 13 months in Elasticsearch (platform-reports-*). Pick a month with the time picker; costs are the average monthly rate over the selected period.",
  "tags": [
    "report",
    "slo",
    "cost",
    "compliance",
    "provisioned"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now/M",
    "to": "now/M"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability, all endpoints",
      "datasource": {
        "type": "elasticsearch",
        "uid": "platform-reports"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "platform-reports"
          },
          "query": "kind:availability",
          "metrics": [
            {
              "id": "1",
              "type": "avg",
              "field": "ratio"
            }
          ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
